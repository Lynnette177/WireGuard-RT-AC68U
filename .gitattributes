* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
Makefile text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.patch text eol=lf
# Patch context has intentional space/tab prefixes; preserve upstream docs.
*.patch -whitespace
/source/README.md whitespace=-blank-at-eol
/dist/SHA256SUMS text eol=lf
/dist/wireguard-go -text
/dist/wgctl -text
/dist/wgctl-check.exe -text
